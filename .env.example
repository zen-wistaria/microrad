# ═══════════════════════════════════════════════════════════════
# DATABASE POSTGRESQL (Dinamis untuk Docker Compose & Next.js App)
# ═══════════════════════════════════════════════════════════════
POSTGRES_USER=microrad
POSTGRES_PASSWORD=microrad
POSTGRES_DB=microrad
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Prisma ORM Connection String
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# ═══════════════════════════════════════════════════════════════
# BETTER AUTH
# ═══════════════════════════════════════════════════════════════
BETTER_AUTH_SECRET="change-me-to-a-random-32-char-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ═══════════════════════════════════════════════════════════════
# INTEGRASI FREERADIUS & MIKROTIK
# ═══════════════════════════════════════════════════════════════
FREERADIUS_IP=freeradius
RADIUS_DEFAULT_SECRET=testing123
MIKROTIK_SYNC_ENABLED=true
MIKROTIK_SYNC_INTERVAL_MS=30000