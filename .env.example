# PostgreSQL (sesuaikan bila kredensial/port berubah — lihat docker-compose.yml)
DATABASE_URL="postgresql://microrad:microrad@localhost:5432/microrad"

# Better Auth — random string minimal 32 karakter (ubah di production!)
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-32-char-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Integrasi FreeRADIUS + MikroTik (lihat docker-compose.yml)
# Hostname docker "freeradius" utk komunikasi antar container;
# host/app memakai localhost:1812-1813 (radtest)
FREERADIUS_IP=freeradius
RADIUS_DEFAULT_SECRET=testing123
MIKROTIK_SYNC_ENABLED=true
MIKROTIK_SYNC_INTERVAL_MS=30000