// Prisma ORM — Prisma 7 (generator butuh `output`; lihat docs)
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// SISTEM AUTH — INSTANCE #1 (appUser: admin/operator, username plugin)
// ═══════════════════════════════════════════════════════════════
model AppUser {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  username      String?   @unique // plugin username (opsional)
  role          String    @default("operator") // admin | operator (legacy denormalized)
  roleId        String? // -> Role.id (RBAC)
  status        String    @default("active") // active | disabled
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role_    Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  sessions AppSession[]
  accounts AppAccount[]

  @@map("app_user")
}

model AppSession {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("app_session")
}

model AppAccount {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  password              String? // hash password (credential provider)
  refreshToken          String?
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerId, accountId])
  @@map("app_account")
}

model AppVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("app_verification")
}

// ═══════════════════════════════════════════════════════════════
// SISTEM AUTH — INSTANCE #2 (portalUser: akun portal pelanggan)
// ═══════════════════════════════════════════════════════════════
model PortalUser {
  id            String   @id
  name          String
  username      String?  @unique
  email         String?  @unique
  emailVerified Boolean  @default(false)
  image         String?
  customerId    String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessions PortalSession[]
  accounts PortalAccount[]

  @@map("portal_user")
}

model PortalSession {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("portal_session")
}

model PortalAccount {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  password              String?
  refreshToken          String?
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerId, accountId])
  @@map("portal_account")
}

model PortalVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("portal_verification")
}

// ═══════════════════════════════════════════════════════════════
// RBAC
// ═══════════════════════════════════════════════════════════════
model Role {
  id          String   @id
  name        String
  description String?
  permissions String[] // 27 permission literals "<resource>.<action>"
  system      Boolean  @default(false) // role bawaan tak bisa dihapus
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users AppUser[]

  @@map("role")
}

// ═══════════════════════════════════════════════════════════════
// DOMAIN
// ═══════════════════════════════════════════════════════════════
model Customer {
  id               String    @id
  username         String    @unique // radcheck.username (unik, case-insensitive di API)
  password         String? // radcheck password (hanya untuk display/update)
  fullName         String?
  email            String?
  phone            String?
  address          String?
  status           String    @default("active") // active | suspended | disabled
  profileId        String? // FK -> InternetProfile.id (Paket Internet)
  profileGroupId   String? // FK -> ProfileGroup.id (Wilayah / Failover Group)
  staticIp         String?
  nasId            String?
  bindOnNas        Boolean   @default(false) // hanya boleh login lewat router di wilayahnya
  sessionMode      String    @default("single") // single | multi
  maxSimultaneous  Int       @default(1) // batas simultan jika multi
  allowedNasIps    String[]  @default([]) // whitelist IP router NAS
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastSeenAt       DateTime?

  profile           InternetProfile?   @relation(fields: [profileId], references: [id], onDelete: SetNull)
  profileGroup      ProfileGroup?      @relation(fields: [profileGroupId], references: [id], onDelete: SetNull)
  router            NasRouter?         @relation(fields: [nasId], references: [id], onDelete: SetNull)
  invoices          Invoice[]
  payments          PaymentRecord[]
  portalUser        PortalUser?
  portalLoginLogs   PortalLoginLog[]
  portalSessionLogs PortalSessionLog[]

  @@map("customer")
}

model Bandwidth {
  id                         String   @id // bw-<timestamp>
  name                       String
  minUpload                  Int?     // CIR Upload (angka)
  minUploadUnit              String   @default("Kbps") // "Kbps" | "Mbps"
  minDownload                Int?     // CIR Download (angka)
  minDownloadUnit            String   @default("Kbps") // "Kbps" | "Mbps"
  maxUpload                  Int      // Max Upload (angka)
  maxUploadUnit              String   @default("Mbps") // "Kbps" | "Mbps"
  maxDownload                Int      // Max Download (angka)
  maxDownloadUnit            String   @default("Mbps") // "Kbps" | "Mbps"

  // Burst configuration (opsional, jika salah satu diisi, kelimanya wajib diisi)
  burstLimitUpload           Int?
  burstLimitUploadUnit       String?  @default("Mbps") // "Kbps" | "Mbps"
  burstLimitDownload         Int?
  burstLimitDownloadUnit     String?  @default("Mbps") // "Kbps" | "Mbps"
  burstThresholdUpload       Int?
  burstThresholdUploadUnit   String?  @default("Mbps") // "Kbps" | "Mbps"
  burstThresholdDownload     Int?
  burstThresholdDownloadUnit String?  @default("Mbps") // "Kbps" | "Mbps"
  burstTime                  Int?     // Detik (1 - 600)

  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  internetProfiles           InternetProfile[]

  @@map("bandwidth")
}

model PppProfile {
  id             String        @id // ppp-<timestamp>
  name           String        // Nama profile di RouterOS (e.g. "profile-node-a1")
  nasId          String        // FK -> NasRouter.id
  type           String        @default("PPP") // Saat ini "PPP"
  ipModule       String        @default("sql") // "sql" (SQL IP Module) | "mikrotik_pool" (Mikrotik IP Pool)
  localAddress   String        // IP Gateway Local PPP (misal "10.10.10.1")
  rangeIpStart   String        // Awal rentang IP pool (misal "10.10.10.2")
  rangeIpEnd     String        // Akhir rentang IP pool (misal "10.10.10.254")
  dnsServers     String        @default("8.8.8.8,8.8.4.4") // DNS Server
  parentQueue    String?       // Parent queue name di RouterOS (opsional)
  profileGroupId String?       // FK -> ProfileGroup.id
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  nasRouter      NasRouter     @relation(fields: [nasId], references: [id], onDelete: Restrict)
  profileGroup   ProfileGroup? @relation(fields: [profileGroupId], references: [id], onDelete: SetNull)

  @@map("ppp_profile")
}

model ProfileGroup {
  id           String       @id // grp-<timestamp>
  name         String       // Nama Wilayah / Area (e.g. "Wilayah Kota A")
  description  String?      // Catatan area / keterangan
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  pppProfiles  PppProfile[]
  customers    Customer[]

  @@map("profile_group")
}

model InternetProfile {
  id             String     @id // net-<timestamp>
  name           String     // Nama Paket (e.g. "Paket 2 Mbps", "Home 10M")
  price          Int        @default(0) // IDR / bulan
  bandwidthId    String
  priority       Int        @default(8) // 1 - 8 (default 8)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  bandwidth      Bandwidth  @relation(fields: [bandwidthId], references: [id], onDelete: Restrict)
  customers      Customer[]

  @@map("internet_profile")
}

model NasRouter {
  id            String    @id
  name          String
  ipAddress     String    @unique // nasname
  location      String?
  type          String    @default("mikrotik")
  // status DERIVED dari poller/ping nyata — bukan input manual
  status        String    @default("unknown") // online | offline | unknown
  // ── Kredensial & integrasi RouterOS (node-routeros) ──
  apiUsername   String? // user admin API RouterOS
  apiPassword   String? // password API RouterOS
  apiPort       Int       @default(8728) // port API RouterOS (8728 = api)
  radiusSecret  String? // shared secret RADIUS → kolom nas.secret di FreeRADIUS
  radiusEnabled Boolean   @default(false) // sudah di-point ke FreeRADIUS (use-radius=yes)?
  syncEnabled   Boolean   @default(true) // ikut poller sinkronisasi sesi?
  lastSeenAt    DateTime? // heartbeat terakhir (poller/ping sukses/gagal)
  lastSyncedAt  DateTime? // tick poller terakhir sukses
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customers     Customer[]
  pppProfiles   PppProfile[]

  @@map("nas_router")
}

model Invoice {
  id               String    @id
  invoiceNumber    String    @unique // INV/YYYY/MM/SEQ
  customerId       String
  customerUsername String // snapshot
  customerFullName String?
  customerPhone    String?
  customerAddress  String?
  profileId        String
  profileName      String // snapshot
  periodMonth      Int // 1-12
  periodYear       Int
  subtotal         Int
  tax              Int
  discount         Int
  adminFee         Int
  installationFee  Int
  taxPercent       Int
  totalAmount      Int
  status           String    @default("unpaid") // paid | unpaid | overdue | cancelled
  issueDate        DateTime
  dueDate          DateTime
  paidAt           DateTime?
  paymentMethod    String? // qris|transfer_bca|transfer_mandiri|transfer_bri|cash|other
  paymentReference String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments PaymentRecord[]

  @@unique([customerId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
  @@index([status])
  @@map("invoice")
}

model PaymentRecord {
  id               String   @id
  invoiceId        String
  invoiceNumber    String
  customerId       String
  customerName     String
  amount           Int
  paymentMethod    String // qris|transfer_bca|transfer_mandiri|transfer_bri|cash|other
  paymentReference String?
  paidAt           DateTime
  receivedBy       String
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([invoiceId])
  @@map("payment_record")
}

model CompanyProfile {
  id        Int      @id @default(1) // single row
  brandName String
  fullName  String
  address   String?
  phone     String?
  email     String?
  website   String?
  npwp      String?
  licenseNo String?
  updatedAt DateTime @updatedAt

  @@map("company_profile")
}

model GlobalLog {
  id        String   @id
  timestamp DateTime
  ipAddress String
  userAgent String
  userName  String
  source    String // portal | app | api
  createdAt DateTime @default(now())

  @@index([timestamp])
  @@index([source])
  @@map("global_log")
}

model PortalLoginLog {
  id               String   @id
  customerId       String
  customerUsername String
  loginAt          DateTime
  ipAddress        String
  userAgent        String
  source           String   @default("portal") // portal | admin
  createdAt        DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, loginAt])
  @@map("portal_login_log")
}

model PortalSessionLog {
  id               String    @id
  customerId       String
  customerUsername String
  nasIpAddress     String
  framedIp         String?
  startedAt        DateTime
  stoppedAt        DateTime?
  durationSeconds  Int
  inputBytes       BigInt
  outputBytes      BigInt
  terminateCause   String?
  createdAt        DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, startedAt])
  @@map("portal_session_log")
}

model WaTemplate {
  id        Int      @id @default(1) // single row
  template  String
  updatedAt DateTime @updatedAt

  @@map("wa_template")
}

// ═══════════════════════════════════════════════════════════════
// TABEL SHARED FreeRADIUS v3 (rlm_sql + driver postgresql)
// Kolom = persis schema default FreeRADIUS mods-config/sql/main/postgresql/
// schema.sql — FreeRADIUS membaca/menulis langsung, app tidak boleh
// menyimpang dari bentuk ini. App mengelola isinya (radsync).
// ═══════════════════════════════════════════════════════════════

// rlm_sql authorize — check attributes (Cleartext-Password dsb)
model RadCheck {
  id        Int    @id @default(autoincrement())
  username  String
  attribute String
  op        String @default(":=")
  value     String

  @@unique([username, attribute]) // upsert radsync
  @@index([username])
  @@map("radcheck")
}

// rlm_sql authorize — reply attributes (Framed-IP-Address, Mikrotik-Rate-Limit)
model RadReply {
  id        Int    @id @default(autoincrement())
  username  String
  attribute String
  op        String @default(":=")
  value     String

  @@unique([username, attribute]) // upsert radsync
  @@index([username])
  @@map("radreply")
}

// FreeRADIUS whitelist router NAS per user (check_nas_binding policy)
model RadNasAllow {
  id           Int      @id @default(autoincrement())
  username     String
  nasIpAddress String   @map("nasipaddress")
  createdAt    DateTime @default(now())

  @@unique([username, nasIpAddress])
  @@index([username])
  @@map("radnasallow")
}

// Dipakai query bawaan FreeRADIUS (authorize_group_check / reply / users)
model RadGroupCheck {
  id        Int    @id @default(autoincrement())
  groupname String
  attribute String
  op        String @default(":=")
  value     String

  @@index([groupname])
  @@map("radgroupcheck")
}

model RadGroupReply {
  id        Int    @id @default(autoincrement())
  groupname String
  attribute String
  op        String @default(":=")
  value     String

  @@index([groupname])
  @@map("radgroupreply")
}

model RadUserGroup {
  id        Int    @id @default(autoincrement())
  username  String
  groupname String
  priority  Int    @default(1)

  @@index([username])
  @@map("radusergroup")
}

// rlm_sql accounting — DITULIS FreeRADIUS (start/interim/stop);
// app hanya membaca (terminateCause, statistik). Tanpa relasi FK —
// FreeRADIUS insert row mentah.
//
// PENTING: query bawaan FreeRADIUS menulis identifier TANPA tanda kutip
// (AcctSessionId, AcctUniqueId, ...) → PostgreSQL men-fold semuanya ke
// lowercase. Karena itu SEMUA kolom tabel ini harus LOWERCASE di DB
// (setara hasil unquote schema.sql resmi), bukan mixed-case.
model RadAcct {
  radAcctId           BigInt    @id @default(autoincrement()) @map("radacctid")
  acctSessionId       String    @map("acctsessionid")
  acctUniqueId        String    @unique @map("acctuniqueid")
  username            String?   @map("username")
  groupname           String?   @map("groupname")
  realm               String?   @map("realm")
  nasIpAddress        String?   @map("nasipaddress") @db.Inet
  nasPortId           String?   @map("nasportid")
  nasPortType         String?   @map("nasporttype")
  acctStartTime       DateTime? @map("acctstarttime") @db.Timestamptz(6)
  acctUpdateTime      DateTime? @map("acctupdatetime") @db.Timestamptz(6)
  acctStopTime        DateTime? @map("acctstoptime") @db.Timestamptz(6)
  acctInterval        BigInt?   @map("acctinterval")
  acctSessionTime     BigInt?   @map("acctsessiontime")
  acctAuthentic       String?   @map("acctauthentic")
  connectInfoStart    String?   @map("connectinfo_start")
  connectInfoStop     String?   @map("connectinfo_stop")
  acctInputOctets     BigInt?   @map("acctinputoctets")
  acctOutputOctets    BigInt?   @map("acctoutputoctets")
  calledStationId     String?   @map("calledstationid")
  callingStationId    String?   @map("callingstationid")
  acctTerminateCause  String?   @map("acctterminatecause")
  serviceType         String?   @map("servicetype")
  framedProtocol      String?   @map("framedprotocol")
  framedIpAddress     String?   @map("framedipaddress") @db.Inet
  framedIpv6Address   String?   @map("framedipv6address") @db.Inet
  framedIpv6Prefix    String?   @map("framedipv6prefix") @db.Inet
  framedInterfaceId   String?   @map("framedinterfaceid")
  delegatedIpv6Prefix String?   @map("delegatedipv6prefix") @db.Inet
  class               String?   @map("class")

  @@index([acctStartTime, username], map: "radacct_start_user_idx")
  @@index([username, acctStartTime], map: "radacct_username_start_idx")
  @@index([acctStopTime, username], map: "radacct_stop_user_idx")
  @@index([nasIpAddress, acctStopTime], map: "radacct_nas_stop_idx")
  @@index([acctStopTime, acctUpdateTime], map: "radacct_stop_update_idx")
  @@map("radacct")
}

// rlm_sql post-auth — hasil Access-Accept/Reject tiap autentikasi
// (template resmi: id bigserial; kolom lowercase hasil unquote).
model RadPostAuth {
  id               BigInt   @id @default(autoincrement()) @map("id")
  username         String   @map("username")
  pass             String?  @map("pass")
  reply            String?  @map("reply")
  calledStationId  String?  @map("calledstationid")
  callingStationId String?  @map("callingstationid")
  authDate         DateTime @default(now()) @map("authdate") @db.Timestamptz(6)
  class            String?  @map("class")

  @@index([username], map: "radpostauth_username_idx")
  @@index([class], map: "radpostauth_class_idx")
  @@map("radpostauth")
}

// FreeRADIUS read_clients=yes — daftar NAS/RADIUS client dari DB
model Nas {
  id          Int     @id @default(autoincrement())
  nasname     String  @unique // IP NAS (MikroTik) — client yang boleh akses
  shortname   String?
  type        String?
  ports       Int?
  secret      String // shared secret RADIUS
  server      String?
  community   String?
  description String?

  @@map("nas")
}

// rlm_sqlippool — Pool IP Dinamis SQL terpusat FreeRADIUS
model RadIpPool {
  id               Int       @id @default(autoincrement()) @map("id")
  poolName         String    @map("pool_name") @db.VarChar(30)
  framedIpAddress  String    @map("framedipaddress") @db.Inet
  nasIpAddress     String    @default("") @map("nasipaddress") @db.VarChar(15)
  calledStationId  String    @default("") @map("calledstationid") @db.VarChar(30)
  callingStationId String    @default("") @map("callingstationid") @db.VarChar(30)
  expiryTime       DateTime? @map("expiry_time") @db.Timestamptz(6)
  username         String    @default("") @map("username") @db.VarChar(64)
  poolKey          String    @default("") @map("pool_key") @db.VarChar(30)

  @@index([poolName, expiryTime], map: "radippool_poolname_expire_idx")
  @@index([framedIpAddress], map: "radippool_framedipaddress_idx")
  @@index([nasIpAddress, poolKey], map: "radippool_nasip_poolkey_idx")
  @@map("radippool")
}
