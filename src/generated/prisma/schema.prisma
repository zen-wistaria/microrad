// Prisma ORM — Prisma 7 (generator butuh `output`; lihat docs)
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════
// SISTEM AUTH — INSTANCE #1 (appUser: admin/operator, username plugin)
// ═══════════════════════════════════════════════════════════════
model AppUser {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  username      String?   @unique // plugin username (opsional)
  role          String    @default("operator") // admin | operator (legacy denormalized)
  roleId        String? // -> Role.id (RBAC)
  status        String    @default("active") // active | disabled
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role_    Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  sessions AppSession[]
  accounts AppAccount[]

  @@map("app_user")
}

model AppSession {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("app_session")
}

model AppAccount {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  password              String? // hash password (credential provider)
  refreshToken          String?
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerId, accountId])
  @@map("app_account")
}

model AppVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("app_verification")
}

// ═══════════════════════════════════════════════════════════════
// SISTEM AUTH — INSTANCE #2 (portalUser: akun portal pelanggan)
// ═══════════════════════════════════════════════════════════════
model PortalUser {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  customerId    String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessions PortalSession[]
  accounts PortalAccount[]

  @@map("portal_user")
}

model PortalSession {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("portal_session")
}

model PortalAccount {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  password              String?
  refreshToken          String?
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerId, accountId])
  @@map("portal_account")
}

model PortalVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("portal_verification")
}

// ═══════════════════════════════════════════════════════════════
// RBAC
// ═══════════════════════════════════════════════════════════════
model Role {
  id          String   @id
  name        String
  description String?
  permissions String[] // 27 permission literals "<resource>.<action>"
  system      Boolean  @default(false) // role bawaan tak bisa dihapus
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users AppUser[]

  @@map("role")
}

// ═══════════════════════════════════════════════════════════════
// DOMAIN
// ═══════════════════════════════════════════════════════════════
model Customer {
  id               String    @id
  username         String    @unique // radcheck.username (unik, case-insensitive di API)
  password         String? // radcheck password (hanya untuk display/update)
  fullName         String?
  email            String?
  phone            String?
  address          String?
  status           String    @default("active") // active | suspended | disabled
  profileId        String?
  staticIp         String?
  nasId            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastSeenAt       DateTime?
  currentSessionId String? // denormalized: sesi aktif pelanggan

  profile           BandwidthProfile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)
  router            NasRouter?         @relation(fields: [nasId], references: [id], onDelete: SetNull)
  sessions          Session[]
  invoices          Invoice[]
  payments          PaymentRecord[]
  portalUser        PortalUser?
  portalLoginLogs   PortalLoginLog[]
  portalSessionLogs PortalSessionLog[]

  @@map("customer")
}

model BandwidthProfile {
  id            String   @id
  name          String
  rateLimitDown Int // Mbps
  rateLimitUp   Int // Mbps
  price         Int? // IDR/bulan
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customers Customer[]

  @@map("bandwidth_profile")
}

model NasRouter {
  id        String   @id
  name      String
  ipAddress String   @unique // nasname
  location  String?
  type      String   @default("mikrotik")
  status    String   @default("online") // online | offline | unknown
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
  customers Customer[]

  @@map("nas_router")
}

model Session {
  id               String    @id
  customerId       String
  customerUsername String
  nasId            String
  nasIpAddress     String
  framedIp         String?
  startedAt        DateTime
  stoppedAt        DateTime?
  durationSeconds  Int // dihitung ulang saat read utk sesi live
  inputBytes       BigInt // AcctInputOctets (upload)
  outputBytes      BigInt // AcctOutputOctets (download)
  terminateCause   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  router   NasRouter @relation(fields: [nasId], references: [id], onDelete: Cascade)

  @@index([customerId, startedAt])
  @@index([nasId])
  @@index([stoppedAt])
  @@map("session")
}

model Invoice {
  id               String    @id
  invoiceNumber    String    @unique // INV/YYYY/MM/SEQ
  customerId       String
  customerUsername String // snapshot
  customerFullName String?
  customerPhone    String?
  customerAddress  String?
  profileId        String
  profileName      String // snapshot
  periodMonth      Int // 1-12
  periodYear       Int
  subtotal         Int
  tax              Int
  discount         Int
  adminFee         Int
  installationFee  Int
  taxPercent       Int
  totalAmount      Int
  status           String    @default("unpaid") // paid | unpaid | overdue | cancelled
  issueDate        DateTime
  dueDate          DateTime
  paidAt           DateTime?
  paymentMethod    String? // qris|transfer_bca|transfer_mandiri|transfer_bri|cash|other
  paymentReference String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments PaymentRecord[]

  @@unique([customerId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
  @@index([status])
  @@map("invoice")
}

model PaymentRecord {
  id               String   @id
  invoiceId        String
  invoiceNumber    String
  customerId       String
  customerName     String
  amount           Int
  paymentMethod    String // qris|transfer_bca|transfer_mandiri|transfer_bri|cash|other
  paymentReference String?
  paidAt           DateTime
  receivedBy       String
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([invoiceId])
  @@map("payment_record")
}

model CompanyProfile {
  id        Int      @id @default(1) // single row
  brandName String
  fullName  String
  address   String?
  phone     String?
  email     String?
  website   String?
  npwp      String?
  licenseNo String?
  updatedAt DateTime @updatedAt

  @@map("company_profile")
}

model GlobalLog {
  id        String   @id
  timestamp DateTime
  ipAddress String
  userAgent String
  userName  String
  source    String // portal | app | api
  createdAt DateTime @default(now())

  @@index([timestamp])
  @@index([source])
  @@map("global_log")
}

model PortalLoginLog {
  id               String   @id
  customerId       String
  customerUsername String
  loginAt          DateTime
  ipAddress        String
  userAgent        String
  source           String   @default("portal") // portal | admin
  createdAt        DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, loginAt])
  @@map("portal_login_log")
}

model PortalSessionLog {
  id               String    @id
  customerId       String
  customerUsername String
  nasIpAddress     String
  framedIp         String?
  startedAt        DateTime
  stoppedAt        DateTime?
  durationSeconds  Int
  inputBytes       BigInt
  outputBytes      BigInt
  terminateCause   String?
  createdAt        DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, startedAt])
  @@map("portal_session_log")
}

model WaTemplate {
  id        Int      @id @default(1) // single row
  template  String
  updatedAt DateTime @updatedAt

  @@map("wa_template")
}
